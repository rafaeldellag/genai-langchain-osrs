# Modelo do Ollama (rode antes: ollama pull qwen3.5:4b)
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434
# O Ollama corta prompts maiores que isso sem avisar
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
# Onde ficam os dados baixados da Wiki (itens, monstros, preços)
# CONSELHEIRO_CACHE=~/.cache/genai-langchain-osrs
